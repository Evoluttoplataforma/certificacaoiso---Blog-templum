# Dependências e build
node_modules/
dist/
.astro/

# Ambiente / sistema
.env
.env.*
.DS_Store
*.log
npm-debug.log*

# Cloudflare
.wrangler/
.dev.vars

# Exports brutos do Search Console (entram só como insumo do scripts/populares.mjs;
# o que vai pro repo é o JSON derivado em src/data/populares.json)
*-Performance-on-Search-*/

# Insumos de conteúdo (transcrições, briefings). Entram como matéria-prima dos
# posts; o que vai pro ar é o conteúdo no Supabase, não o arquivo bruto.
# Ancorado na raiz de propósito: sem a barra da frente, a regra pegava qualquer pasta
# chamada "conteudo" em qualquer nível — inclusive supabase/posts/, que É pra versionar.
/conteudo/

# MP3 dos resumos em áudio, cacheados por hash do roteiro (scripts/audio-resumo.mjs).
# O que vai pro ar mora no Supabase Storage; isto é só pra não repagar o TTS numa
# retentativa. ~50MB e crescendo — não entra no repo do blog.
.audio-cache/
