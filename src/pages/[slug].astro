---
import Base from "../layouts/Base.astro";
import ArticleCard from "../components/ArticleCard.astro";
import LeadForm from "../components/LeadForm.astro";
import WebinarCard from "../components/WebinarCard.astro";
import { catMeta } from "../data/categorias.js";
import { ctaParaNorma } from "../data/cta-norma.js";
import { ancorarSecoes, injetarCtaMeio, removerSumarioEscrito, temSumarioEscrito } from "../lib/artigo.js";
import { normaDoForm } from "../data/lead-form-pages.js";
import { normaDaPagina } from "../data/normas.js";
import { getAllPosts, tldrOf } from "../lib/posts.js";
import { ehLongform } from "../data/longform.js";

// Keys públicas (anon) para o POST do formulário de consultoria — mesmas de lib/posts.js.
// A anon key é pública por definição; o que protege a tabela é a RLS (só INSERT p/ anon).
const SB_URL = import.meta.env.SUPABASE_URL || "https://yfpdrckyuxltvznqfqgh.supabase.co";
const SB_ANON = import.meta.env.SUPABASE_ANON_KEY || "sb_publishable_Yfg9Ts5WRqD4Gc3jeWAS2A_-YWZrtiQ";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const d = post.data;
const SITE = "https://certificacaoiso.com.br";
const url = `${SITE}/${post.slug}/`;
const cat = (d.categories && d.categories[0]) || "";
const catSlug = cat ? catMeta(cat).slug : "";
const fmtData = (x) => new Date(x).toLocaleDateString("pt-BR", { day: "2-digit", month: "long", year: "numeric" });
const dataFmt = fmtData(d.pubDate);
// "Atualizado em ..." vem de `revisedDate` (col. revised_at), que é CURADA.
// NÃO usar updatedDate aqui: o trigger do Supabase toca updated_at em qualquer UPDATE, e
// operações em lote deixaram 799 posts com a mesma data — o selo apareceria em ~todo post
// e não significaria nada. Guarda extra: só exibe se for depois da publicação.
const atualizadoEm = d.revisedDate && +new Date(d.revisedDate) > +new Date(d.pubDate)
  ? new Date(d.revisedDate) : null;

// SEO/AIEO/GEO por artigo
// título: usa seo_title; senão anexa a marca. NUNCA deixa igual ao <h1> (evita "h1 = title").
// Sufixo com keyword quando cabe (~60); senão sufixo curto " — Templum" (mais leve, mas ≠ h1).
const _full = `${d.title} | Certificação ISO`;
const seoTitle = d.seoTitle || (_full.length <= 60 ? _full : `${d.title} — Templum`);
const tldr = (d.tldr || tldrOf(post)).trim();
const seoDesc = (d.seoDescription || d.description || tldr).slice(0, 160);
const keywords = (d.keywords && d.keywords.length ? d.keywords : d.categories) || [];
// wordCount a partir do HTML (sinal de profundidade p/ SEO/GEO)
const wordCount = post.content ? post.content.replace(/<[^>]+>/g, " ").split(/\s+/).filter(Boolean).length : 0;
const faq = d.faq || [];
// Formulário de consultoria: só nas páginas curadas (ver data/lead-form-pages.js).
// Onde ele entra, substitui o CTA genérico do fim do artigo — dois CTAs empilhados
// pedindo a mesma coisa disputam o mesmo clique e derrubam os dois.
const normaForm = normaDoForm(post.slug);

// Norma da página para a tag do Clarity (ver data/normas.js). Sem ela a gravação chega no
// painel sem assunto e não há como comparar conversão entre clusters de norma.
// `.display` — normaForm é o objeto { display, crm } de lead-form-pages.js, não uma
// string. Sem isso a tag ia como "[object Object]" nas páginas curadas cuja norma não
// aparece no título (SASSMAQ, GERIC, fluxograma), e o &norma= do CTA saía igual.
const normaClarity = normaDaPagina({ categories: d.categories, title: d.title, slug: post.slug }) || normaForm?.display || "";

// ---------- CTA: UM POR ARTIGO (MEIO E FIM) ----------
// A tarja de CTA da primeira dobra saiu em 21/08/2026, junto com a sidebar. O artigo
// tinha QUATRO blocos pedindo a mesma coisa — tarja do topo, card da sidebar, bloco do
// meio e bloco do fim — e CTA repetido não soma clique, divide: o leitor aprende a
// pular o formato antes de ler a oferta. Ficaram dois, em posições que não competem:
// o do meio (só em artigo longo) e o do fim.
// Para quem for ler a série depois: a queda em cta-topo e cta-sidebar-diagnostico a
// partir de 21/08/2026 é ISTO, não sazonalidade. A linha de base para julgar se valeu
// é lead por sessão, não clique por sessão. Se um CTA acima da dobra voltar, ele volta
// medido contra esta versão — o histórico das três tentativas está no git log.
const cta = ctaParaNorma(d.categories || []);

// ---------- LAYOUT LONGFORM (experimento — ver data/longform.js) ----------
const longform = ehLongform(post.slug);

// A "Resposta rápida" mediana tem 295 caracteres (68% dos posts passam de 260) — no
// celular são ~9 linhas, ~264px, e era ela que empurrava a tarja de CTA para fora da
// dobra em 37% dos posts. Acima de ~185 caracteres (≈5 linhas de 37) o texto entra
// recortado, com "ver tudo". O parágrafo INTEIRO continua no HTML — o recorte é só
// visual (line-clamp), então Google e IA seguem citando o texto completo, que é a razão
// de o bloco existir. E só no celular: no desktop as mesmas 295 letras ocupam 6 linhas
// dentro de uma dobra bem mais alta, não há o que economizar.
const tldrLongo = tldr.length > 185;

// ---------- CORPO DO ARTIGO: ÂNCORAS, SUMÁRIO E CTA DO MEIO ----------
// (ver src/lib/artigo.js — as transformações são feitas no build, não no banco)
const { html: htmlAncorado, secoes } = ancorarSecoes(post.content || "");

// Sumário só onde ele informa: com 3+ seções. Abaixo disso a lista repetiria o que já
// se vê rolando meio dedo, custando altura na dobra sem dar nada em troca. Dos 1.020
// posts, 519 têm 3+ seções — e agora os 519 mostram o índice do template (eram 516: os
// outros 3 o perdiam por trazerem a palavra "sumário" numa frase, ver temSumarioEscrito
// em lib/artigo.js).
//
// 281 posts trazem um sumário ESCRITO À MÃO no corpo, herdado do WordPress, e desde que
// o <details> existe eles mostravam dois índices na mesma página (medido em 21/08/2026:
// 279 dos 281). O escrito à mão sai — é o pior dos dois: sempre aberto, sem o "15
// seções" e diferente de post para post.
//
// A ORDEM aqui é o que dá a garantia: só limpa onde o <details> vai de fato aparecer
// (3+ seções). Nos poucos posts abaixo disso o sumário do corpo é o único índice da
// página, então ele fica — e o temSumarioEscrito abaixo, lido do HTML JÁ LIMPO, é o que
// impede o template de empilhar um segundo em cima dele.
const podeLimpar = secoes.length >= 3;
const { html: htmlLimpo } = podeLimpar
  ? removerSumarioEscrito(htmlAncorado)
  : { html: htmlAncorado };
const temSumarioInline = temSumarioEscrito(htmlLimpo);
// O FAQ entra como última linha porque ele JÁ é uma seção da página, com id="duvidas"
// desde sempre; deixá-lo fora faria o sumário mentir sobre a profundidade do artigo.
// Só não entra quando o próprio corpo já tem um h2 com esse nome (73 posts têm) — senão
// o sumário sairia com "Perguntas frequentes" duas vezes, como saía em programa-5s-e-a-iso-9001.
const faqNoSumario = faq.length > 0
  && !secoes.some((s) => s.titulo.toLowerCase() === "perguntas frequentes");
const sumario = !temSumarioInline && secoes.length >= 3
  ? [...secoes, ...(faqNoSumario ? [{ id: "duvidas", titulo: "Perguntas frequentes" }] : [])]
  : [];

// CTA do meio: só nos artigos longos. No corpo mediano (871 palavras, 3 h2) não existe
// "meio" — o bloco cairia a um dedo de rolagem da tarja do topo. O corte em 1.200
// palavras pega 195 posts, e 167 deles (86%) acabam com o bloco; os 28 restantes ou já
// traziam um cta-olivia à mão, ou têm menos de 3 seções, ou não têm nenhum h2 caindo na
// janela 30–70% — ver injetarCtaMeio() em lib/artigo.js.
// Copy diferente da tarja de propósito: repetir a MESMA pergunta duas vezes na mesma
// página lê como script, não como oferta. A tarja pergunta pela norma; aqui o gancho é o
// que o leitor acabou de ler, e o corpo é o `texto` de cta-norma.js (que a tarja não usa).
const urlMeio = normaForm
  ? "#consultoria"
  : `/form/?utm_source=blog&utm_medium=cta-meio&origem=cta-meio&utm_campaign=${post.slug}&utm_term=${cta.slug}${normaClarity ? `&norma=${encodeURIComponent(normaClarity)}` : ""}`;
const blocoCtaMeio = `<div class="cta-olivia"><img src="/assets/team/olivia-especialista.webp" alt="Olívia, especialista Templum" width="44" height="44" decoding="async" /><div><strong>Quer isso avaliado na sua empresa?</strong><p>${cta.texto}</p><a href="${urlMeio}" class="btn btn--primary" data-trk-event="cta-meio" data-trk-norma="${cta.slug}">Falar com a Olívia <iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a></div></div>`;
// injeta no HTML JÁ LIMPO: o CTA vai para a fronteira de h2 mais perto da metade do
// TEXTO, e as ~15 linhas do sumário do corpo deslocavam esse cálculo.
const conteudo = wordCount >= 1200 ? injetarCtaMeio(htmlLimpo, blocoCtaMeio) : htmlLimpo;

// ---------- RELACIONADOS: relevância por tag + garantia de distribuição ----------
// Em lib/posts.js, `categories` é [category_name, ...tags] — categoria e tags no
// MESMO array. O filtro abaixo já casava tag, mas SEM PESO: um post que compartilha
// só a categoria larga ("Segurança e Compliance" tem 27001, LGPD, 37001 e ataque
// hacker dentro) empatava com outro que compartilha 4 tags do mesmo requisito.
// Agora tag em comum vale 3 e a categoria vale 1 — quem trata do mesmo assunto sobe.
const catList = posts.filter((p) => p.data.categories?.some((c) => d.categories?.includes(c)));
const selfPos = catList.findIndex((p) => p.slug === post.slug);
const catDe = (p) => (p.data.categories || [])[0] || "";
const tagsDe = (p) => (p.data.categories || []).slice(1);
const minhasTags = new Set(tagsDe(post));
const minhaCat = catDe(post);
const relevancia = (p) => {
  let s = 0;
  for (const t of tagsDe(p)) if (minhasTags.has(t)) s += 3;
  if (catDe(p) === minhaCat) s += 1;
  return s;
};
const porRelevancia = catList
  .filter((p) => p.slug !== post.slug)
  .map((p) => ({ p, s: relevancia(p) }))
  // empate resolve pelo mais recente
  .sort((a, b) => b.s - a.s || +new Date(b.p.data.pubDate) - +new Date(a.p.data.pubDate))
  .map((x) => x.p);

const recent = posts
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate))
  .slice(0, 5);

// GARANTIA DE DISTRIBUIÇÃO: os 2 primeiros cards são os vizinhos do anel cíclico.
// Ordenar só por relevância concentraria os links nos posts com muitas tags e deixaria
// os magros órfãos — evitar órfão é o motivo de o anel existir.
//
// São SEIS cards (eram 3) porque a sidebar saiu em 21/08/2026 e com ela os 3 links
// internos que ela distribuía. Sem repor aqui, cada post passaria a doar metade dos
// links de cluster que doava, em 1.020 páginas — e link interno é o único orçamento de
// autoridade que este blog controla sozinho. Total por página segue 6, agora todos no
// mesmo bloco, onde o leitor que terminou o texto está de fato olhando.
const vizinho = catList.length > 1 ? catList[(selfPos + 1) % catList.length] : null;
const vizinho2 = catList.length > 2 ? catList[(selfPos + 2) % catList.length] : null;
const usados = new Set([post.slug]);
const related = [];
for (const v of [vizinho, vizinho2]) {
  if (v && !usados.has(v.slug)) { related.push(v); usados.add(v.slug); }
}
// Fallback com recentes para o bloco não sair pela metade em categoria pequena.
for (const lista of [porRelevancia, recent]) {
  for (const p of lista) {
    if (related.length >= 6) break;
    if (!usados.has(p.slug)) { related.push(p); usados.add(p.slug); }
  }
}

// --- JSON-LD: BlogPosting + BreadcrumbList ---
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: d.title,
    // usa o mesmo texto do <meta name="description"> (seo_description quando escrito).
    // NÃO usar d.description: é o excerpt cru da migração (1º parágrafo do artigo).
    description: seoDesc,
    image: d.heroImage ? [new URL(d.heroImage, SITE).href] : undefined,
    datePublished: new Date(d.pubDate).toISOString(),
    // dateModified conservador: só avança com revisão curada. Se usasse updatedDate, 799 posts
    // declarariam a mesma data de modificação — padrão que faz o Google desconfiar das datas.
    dateModified: new Date(atualizadoEm || d.pubDate).toISOString(),
    author: { "@type": "Person", name: d.author },
    publisher: { "@id": `${SITE}/#organization` },
    mainEntityOfPage: url,
    inLanguage: "pt-BR",
    articleSection: cat || undefined,
    abstract: tldr || undefined,
    wordCount: wordCount || undefined,
    keywords: keywords.length ? keywords : undefined,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Blog", item: `${SITE}/` },
      cat ? { "@type": "ListItem", position: 2, name: cat, item: `${SITE}/categoria/${catSlug}/` } : null,
      { "@type": "ListItem", position: cat ? 3 : 2, name: d.title, item: url },
    ].filter(Boolean),
  },
];

// FAQPage só quando o artigo tem perguntas (preenchido no CMS) → "sanfoninhas" no Google.
if (faq.length) {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.pergunta,
      acceptedAnswer: { "@type": "Answer", text: f.resposta },
    })),
  });
}
---

<Base
  title={seoTitle}
  description={seoDesc}
  ogImage={d.ogImage || d.heroImage || "/assets/og/certificacaoiso-og.jpg"}
  ogType="article"
  schemas={schemas}
  clarityTags={{
    page_type: "artigo",
    categoria: cat,
    norma: normaClarity,
    tem_form: normaForm ? "sim" : "nao",
  }}
>
  <article class:list={["post", longform && "is-longform"]}>
    <!-- `container` sem tamanho: a largura sai de --medida (ver <style>), para o h1, o
         texto e os comentários dividirem a MESMA borda esquerda. Antes o cabeçalho era
         `md` (1.024) e o texto ocupava 812 — as duas colunas não se alinhavam. -->
    <div class="container post-head">
      <nav class="post-bc">
        <a href="/">Blog</a>
        {cat && <><span>/</span><a href={`/categoria/${catSlug}/`}>{cat}</a></>}
      </nav>
      <h1 class="post-title">{d.title}</h1>
      <div class="post-meta">
        <span class="post-author"><iconify-icon icon="solar:user-circle-bold"></iconify-icon> {d.author}</span>
        <time datetime={new Date(d.pubDate).toISOString()}>{dataFmt}</time>
        {atualizadoEm && (
          <span class="post-upd">
            <iconify-icon icon="solar:refresh-bold"></iconify-icon>
            Atualizado em <time datetime={atualizadoEm.toISOString()}>{fmtData(atualizadoEm)}</time>
          </span>
        )}
      </div>
    </div>

    {d.heroImage && (
      <div class="container lg"><div class="post-hero"><img src={d.heroImage} alt={d.title} /></div></div>
    )}

    <div class="container lg post-grid">
      <div class="post-content">
        {tldr && (
          <div class:list={["post-tldr", tldrLongo && "is-clamp"]}>
            <span class="post-tldr-label"><iconify-icon icon="solar:bolt-bold"></iconify-icon> Resposta rápida</span>
            <p>{tldr}</p>
            {tldrLongo && <button type="button" class="post-tldr-more">ver tudo</button>}
          </div>
        )}

        <!-- Sumário: details FECHADO por padrão, e não uma lista aberta. Aberta, ela
             custaria ~200px de altura logo acima do texto — justo a altura que o CTA da
             tarja acabou de ganhar na dobra. Fechado, o rótulo já entrega o sinal de
             profundidade que o Clarity pedia ("8 seções") em uma linha só, e quem quer
             navegar abre. -->
        {sumario.length > 0 && (
          <details class="post-toc">
            <summary>
              <iconify-icon icon="solar:list-check-minimalistic-bold"></iconify-icon>
              <span class="post-toc-t">Neste artigo</span>
              <span class="post-toc-n">{sumario.length} seções</span>
            </summary>
            <ol>
              {sumario.map((s) => (
                <li><a href={`#${s.id}`} data-trk-event="link-sumario">{s.titulo}</a></li>
              ))}
            </ol>
          </details>
        )}

        <!-- Embrulho do corpo: dá um alvo para a capitular do longform ("> p:first-child")
             sem que ela caia no parágrafo da Resposta rápida, que também é o primeiro
             <p> de um irmão. Sem estilo próprio — em post normal é um div a mais e nada
             muda. -->
        <div class="post-corpo"><Fragment set:html={conteudo} /></div>

        {/* id="duvidas": o sumário dos posts aponta pra #duvidas. Sem o id, migrar o FAQ
            inline pra cá quebraria essa âncora. */}
        {faq.length > 0 && (
          <section class="post-faq" id="duvidas">
            <h2>Perguntas frequentes</h2>
            {faq.map((f) => (
              <details class="post-faq-item">
                <summary>{f.pergunta}</summary>
                {/* set:html porque as respostas do blog têm links internos e múltiplos
                    parágrafos — com interpolação simples o HTML virava texto literal. */}
                <div class="post-faq-a" set:html={f.resposta} />
              </details>
            ))}
          </section>
        )}

        <!-- Webinar da semana, versão mobile: entra depois do texto e do FAQ, antes do
             CTA de consultoria. No desktop este some e quem aparece é o da sidebar. -->
        <WebinarCard variante="conteudo" />

        <!-- Fim do artigo: form de consultoria nas páginas curadas, CTA genérico nas demais -->
        {normaForm ? (
          <LeadForm norma={normaForm.display} crmNorma={normaForm.crm} slug={post.slug} sbUrl={SB_URL} sbAnon={SB_ANON} />
        ) : (
          <div class="post-cta">
            <div>
              <h3>Pronto para certificar sua empresa?</h3>
              <p>Fale com um especialista da Templum e receba um diagnóstico gratuito — com garantia de 200%.</p>
            </div>
            <!-- O evento continua "cta-artigo", e não "cta-fim", de propósito: ele existe
                 desde 22/06/2026 e renomear zeraria a série no GA4/Meta justo agora, que
                 é quando ela serve de linha de base para o "cta-topo". Aqui, cta-artigo =
                 posição FIM. utm_term entrou para o clique do fim ser comparável com o do
                 topo por norma, não só no total. -->
            <a href={`/form/?utm_source=blog&utm_medium=cta-artigo&origem=cta-artigo&utm_campaign=${post.slug}&utm_term=${cta.slug}${normaClarity ? `&norma=${encodeURIComponent(normaClarity)}` : ""}`} class="btn btn--primary btn--lg" data-trk-event="cta-artigo" data-trk-norma={cta.slug}>Falar com um especialista <iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
          </div>
        )}
      </div>
      <!-- SIDEBAR REMOVIDA em 21/08/2026 (componente ainda em git: components/Sidebar.astro).
           Ela carregava autor + webinar + card da Olívia + 3 relacionados; o autor já
           está no .post-meta, o webinar passou a aparecer no fim do artigo em qualquer
           largura, o card da Olívia era o terceiro pedido igual da mesma página e os
           relacionados dobraram no bloco do rodapé. O que fica no lugar dela é ar — e,
           no longform, um trilho de índice, que é navegação e não oferta. -->

      <!-- Trilho de índice fixo na margem direita (só no longform, só >=1180px).
           Emprestado do antihype.com.br/long/*: ali é uma linha do tempo de anos; aqui,
           a seção em que o leitor está. É o mesmo `sumario` do <details>, que no
           longform desktop fica escondido para não haver dois índices na tela. -->
      {longform && sumario.length > 0 && (
        <nav class="post-rail" aria-label="Seções deste artigo">
          <span class="post-rail-h">Neste artigo</span>
          <ol>
            {sumario.map((sec) => (
              <li><a href={`#${sec.id}`} data-trk-event="link-trilho"><span>{sec.titulo}</span></a></li>
            ))}
          </ol>
        </nav>
      )}
    </div>

    <!-- Comentários (client-side: lê aprovados, envia como pendente) -->
    <section class="container post-comments">
      <h2>Comentários</h2>
      <div id="cmt-list" class="cmt-list"><p class="cmt-empty">Carregando…</p></div>
      <form id="cmt-form" class="cmt-form">
        <h3>Deixe seu comentário</h3>
        <div class="cmt-row">
          <input name="nome" placeholder="Seu nome" required />
          <input name="email" type="email" placeholder="Seu e-mail (não publicado)" />
        </div>
        <textarea name="content" rows="4" placeholder="Escreva seu comentário…" required></textarea>
        <!-- Honeypot. O form de comentário é o endpoint mais exposto do blog: POST anônimo
             para o Supabase, presente nas 1.020 páginas, sem nada que distinga bot de
             leitor. Um terço do tráfego bruto é bot (relatório de 20/08/2026) e a tabela
             tem 2.526 linhas — encher a fila de moderação é trivial sem isto. -->
        <div class="hp-off" aria-hidden="true">
          <label>Site<input name="site" tabindex="-1" autocomplete="off" /></label>
        </div>
        <div class="cmt-actions">
          <button type="submit" class="btn btn--primary">Enviar comentário</button>
          <span id="cmt-msg" class="cmt-msg"></span>
        </div>
        <p class="cmt-note">Seu comentário passa por moderação antes de aparecer.</p>
      </form>
    </section>
    <!-- "ver tudo" do TL;DR: tira o recorte e some. Sem framework e sem listener global —
         é um botão só, e a página já carrega JS suficiente. Se o JS não rodar, o pior
         caso é um parágrafo recortado em 5 linhas: o texto continua no HTML para busca e
         IA, e o CTA logo abaixo continua clicável. -->
    <script is:inline>
      (function () {
        var b = document.querySelector(".post-tldr-more");
        if (!b) return;
        var box = b.closest(".post-tldr");
        function abrir() { box.classList.remove("is-clamp"); box.style.cursor = ""; b.remove(); }
        b.addEventListener("click", abrir);
        // O texto recortado também abre: no Clarity, clique no parágrafo cortado é clique
        // morto — o leitor tenta expandir onde a frase termina, não no rótulo "ver tudo".
        box.style.cursor = "pointer";
        box.addEventListener("click", function (e) { if (e.target !== b) abrir(); });
      })();

      // ---- Trilho de índice: qual seção está sendo lida ----
      // A primeira linha desiste em 1.019 dos 1.020 posts (o trilho só existe no
      // longform) e também no celular, onde o CSS o esconde: querySelector devolve o
      // nó, mas offsetParent é null e a função sai sem ligar listener nenhum.
      (function () {
        var trilho = document.querySelector(".post-rail");
        if (!trilho || !trilho.offsetParent) return;
        var links = [].slice.call(trilho.querySelectorAll("a"));
        var alvos = [], porId = {};
        links.forEach(function (a) {
          var id = decodeURIComponent((a.getAttribute("href") || "").slice(1));
          var el = id && document.getElementById(id);
          if (el) { alvos.push(el); porId[id] = a; }
        });
        if (!alvos.length) return;
        var atual = null;
        function marcar() {
          // "Seção atual" = a ÚLTIMA cujo título já passou do topo, não a mais visível
          // na tela. Numa seção de 600 palavras o título sai de vista e o leitor
          // continua nela — pelo critério da visibilidade o trilho apagaria no meio da
          // leitura, que é justo quando ele serve.
          var novo = null;
          for (var i = 0; i < alvos.length; i++) {
            if (alvos[i].getBoundingClientRect().top <= 120) novo = alvos[i];
          }
          if (novo === atual) return;
          atual = novo;
          links.forEach(function (a) { a.classList.remove("is-atual"); });
          if (atual && porId[atual.id]) porId[atual.id].classList.add("is-atual");
        }
        // rAF como trava: scroll dispara dezenas de vezes por segundo e cada passada
        // são 8 getBoundingClientRect (leitura de layout). Uma por frame basta.
        var preso = false;
        function agendar() {
          if (preso) return;
          preso = true;
          requestAnimationFrame(function () { preso = false; marcar(); });
        }
        marcar();
        addEventListener("scroll", agendar, { passive: true });
        addEventListener("resize", agendar);
      })();

      // ---- Zoom nas imagens do artigo ----
      // São 3.290 imagens em 1.020 posts, e clicar numa delas não fazia nada — parte dos
      // 634 cliques mortos do relatório de 20/08/2026. Comportamento esperado de imagem
      // em artigo é ampliar, então é o que passa a acontecer. Sem biblioteca: overlay
      // criado no primeiro clique e reaproveitado.
      // Fica de fora imagem dentro de link (banner de consultoria) — ali o clique já tem
      // destino — e imagem pequena (ícone, selo), que não tem o que ampliar.
      (function () {
        var conteudo = document.querySelector(".post-content");
        if (!conteudo) return;
        var over, alvo;
        function fechar() { if (over) { over.hidden = true; document.body.style.overflow = ""; } }
        conteudo.addEventListener("click", function (e) {
          var img = e.target.closest && e.target.closest("img");
          if (!img || img.closest("a") || img.naturalWidth < 320) return;
          if (!over) {
            over = document.createElement("div");
            over.className = "img-zoom";
            over.hidden = true;
            over.innerHTML = '<button type="button" aria-label="Fechar">&times;</button><img alt="" />';
            over.addEventListener("click", fechar);
            document.body.appendChild(over);
            alvo = over.querySelector("img");
            document.addEventListener("keydown", function (ev) { if (ev.key === "Escape") fechar(); });
          }
          alvo.src = img.currentSrc || img.src;
          alvo.alt = img.alt || "";
          over.hidden = false;
          document.body.style.overflow = "hidden";
        });
        // Cursor de zoom SÓ onde o clique amplia de verdade — mesmo filtro do handler,
        // inclusive o tamanho. Sem a checagem de largura, a foto da Olívia (160px) na
        // tarja do topo ganhava cursor de zoom e não ampliava: seria criar clique morto
        // justo na tela que veio corrigir clique morto. naturalWidth só existe depois da
        // carga, daí marcar no load de quem ainda não chegou.
        function marcaZoom(i) { if (!i.closest("a") && i.naturalWidth >= 320) i.classList.add("is-zoomable"); }
        conteudo.querySelectorAll("img").forEach(function (i) {
          if (i.complete) marcaZoom(i);
          else i.addEventListener("load", function () { marcaZoom(i); }, { once: true });
        });
      })();
    </script>

    <script define:vars={{ postId: post.id, SB_URL: "https://yfpdrckyuxltvznqfqgh.supabase.co", SB_ANON: "sb_publishable_Yfg9Ts5WRqD4Gc3jeWAS2A_-YWZrtiQ" }}>
      (function () {
        var H = { apikey: SB_ANON, Authorization: "Bearer " + SB_ANON };
        var list = document.getElementById("cmt-list");
