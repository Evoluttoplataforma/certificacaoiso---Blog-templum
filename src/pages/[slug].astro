  .post-comments .cmt-body { min-width: 0; flex: 1; }
  .post-comments .cmt-h { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-bottom: 4px; }
  .post-comments .cmt-h strong { font-size: 14.5px; font-weight: 800; color: var(--text); }
  .post-comments .cmt-h time { font-size: 12px; color: var(--text-soft); }
  .post-comments .cmt p { font-size: 14.5px; color: var(--text-2); line-height: 1.6; white-space: pre-line; overflow-wrap: anywhere; }
