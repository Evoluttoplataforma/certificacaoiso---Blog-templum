---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import TrackingKit from "../components/TrackingKit.astro";
import WebinarDock from "../components/WebinarDock.astro";

const {
  title = "Certificação ISO — Dicas para implementação e certificação nas normas ISO",
  description = "Conteúdo prático sobre certificação e implementação das normas ISO: ISO 9001, 14001, 45001, 27001, PBQP-H, FSSC 22000 e mais. Por especialistas da Templum.",
  ogImage = "/assets/og/certificacaoiso-og.jpg",
  ogType = "website",
  schemas = [],
  noChrome = false,
  robots = "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1",
  preloadImage = "",
  // Tags de contexto para o Microsoft Clarity (page_type, norma, categoria...). O Clarity
  // já sabe device/browser/país/origem por conta própria — aqui vai só o que ele NÃO tem:
  // de que assunto é a página e se ela tem formulário. É o que faz a gravação ser filtrável.
  clarityTags = {},
  // Dock do webinar no mobile. Ligado em tudo, MENOS onde já existe um pedido na tela:
  // no /form/ uma barra fixa cobrindo o formulário disputaria o lead que já decidiu vir.
  dock = true,
} = Astro.props;

const SITE = (Astro.site?.href || "https://certificacaoiso.com.br/").replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const ogImageUrl = ogImage.startsWith("http") ? ogImage : new URL(ogImage, Astro.site).href;

// --- JSON-LD base: Organization (Templum, publisher) + WebSite (Certificação ISO) ---
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${SITE}/#organization`,
  name: "Templum Consultoria",
  alternateName: "Certificação ISO",
  url: `${SITE}/`,
  logo: { "@type": "ImageObject", url: `${SITE}/assets/logo/templum.png` },
  sameAs: [
    "https://www.instagram.com/templumconsultoriailimitada/",
    "https://www.linkedin.com/company/3033783/",
    "https://templum.com.br",
  ],
};
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE}/#website`,
  url: `${SITE}/`,
  name: "Certificação ISO",
  description: "Dicas para implementação e certificação nas normas ISO.",
  inLanguage: "pt-BR",
  publisher: { "@id": `${SITE}/#organization` },
  potentialAction: {
    "@type": "SearchAction",
    target: { "@type": "EntryPoint", urlTemplate: `${SITE}/buscar/?q={search_term_string}` },
    "query-input": "required name=search_term_string",
  },
};
const allSchemas = [orgSchema, websiteSchema, ...schemas];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Tracking (Clarity + GA4 x2 + Google Ads + tracking-kit) carregado SÓ na 1ª
         interação do usuário (ou ocioso pós-load) → fora do caminho crítico de render. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function(){ dataLayer.push(arguments); };
      (function () {
        var done = false;
        function boot() {
          if (done) return; done = true;
          // Microsoft Clarity
          (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script","sr5nwfj8jc");
          // Google gtag (GA4 x2 + Ads)
          var g=document.createElement("script");g.async=true;g.src="https://www.googletagmanager.com/gtag/js?id=G-2BW8QTYLB5";document.head.appendChild(g);
          gtag("js", new Date());
          gtag("config","G-2BW8QTYLB5",{send_page_view:false});
          gtag("config","G-FV41GWD427",{send_page_view:false});
          gtag("config","AW-17896226473");
          // tracking-kit (definido em TrackingKit.astro)
          if (typeof window.__loadTrackingKit === "function") window.__loadTrackingKit();
        }
        var evs = ["pointerdown","touchstart","keydown","scroll","mousemove"];
        var opts = { once: true, passive: true, capture: true };
        function once(){ evs.forEach(function(e){ window.removeEventListener(e, once, opts); }); boot(); }
        evs.forEach(function(e){ window.addEventListener(e, once, opts); });
        // fallback: sessões sem interação ainda são rastreadas (após load + ocioso)
        window.addEventListener("load", function(){
          var idle = window.requestIdleCallback || function(cb){ return setTimeout(cb, 6000); };
          idle(function(){ setTimeout(boot, 6000); });
        });
      })();
    </script>

    <!-- Clarity: fila pré-boot + tags de contexto + eventos de funil.
         O snippet acima só carrega na 1ª interação, então tudo que é chamado antes
         disso precisa de fila própria — daí o stub abaixo. -->
    <script is:inline define:vars={{ clarityTags }}>
      // Stub com a MESMA forma do snippet oficial (fila em .q, que o clarity.js drena ao
      // carregar). Como o snippet faz `c[a]=c[a]||...`, ele PRESERVA este stub: nenhum
      // set/event/upgrade disparado antes do boot se perde.
      window.clarity = window.clarity || function () {
        (window.clarity.q = window.clarity.q || []).push(arguments);
      };

      (function () {
        function C() { try { window.clarity.apply(null, arguments); } catch (e) {} }
        // Helpers globais — usados também pelos forms (LeadForm.astro, /presentes/*).
        window.clarityTag     = function (k, v) { if (v !== undefined && v !== null && v !== "") C("set", k, String(v)); };
        window.clarityEvent   = function (n) { C("event", n); };
        // upgrade() = "esta sessão importa, grave ela". É o que garante que a sessão de
        // quem mexeu no formulário ou saiu pro funil não seja descartada por amostragem.
        window.clarityUpgrade = function (r) { C("upgrade", r); };

        var t = clarityTags || {};
        Object.keys(t).forEach(function (k) { window.clarityTag(k, t[k]); });

        // ---- Quem está quebrando? (erro de JS e de recurso viram tag no Clarity) ----
        // O relatório de 20/08/2026 apontou "1 em cada 5 sessões com erro de JavaScript",
        // 95% deles variações de "a.includes is not a function" — e não havia como saber
        // de quem era: o blog não tem UMA chamada a .includes() no navegador (conferido
        // nos 1.036 HTML), e um Chrome limpo não reproduz o erro em nenhum tipo de página.
        // Sobra o que só o campo responde: script de terceiro, extensão do leitor ou
        // navegador embutido de app (Instagram/Facebook injetam JS na página).
        //
        // Daí este beacon. Ele não conserta nada — dá NOME ao culpado no próximo
        // relatório, filtrável por `erro_js` no Clarity, com a sessão gravada.
        //
        // Duas limitações que valem saber antes de ler o dado:
        //   · script de outra origem sem CORS chega como "Script error." e sem arquivo.
        //     Isso, por si, JÁ é informação: significa que não é código nosso;
        //   · content script de extensão roda em mundo isolado e normalmente não cai
        //     aqui — ausência de registro com volume alto no painel aponta para extensão.
        // Teto de 3 por sessão: erro em laço encheria a fila do Clarity e o dado viraria
        // ruído (12.069 erros no relatório vêm de repetição, não de 12 mil leitores).
        var nErros = 0;
        function reportaErro(rotulo, detalhe) {
          if (nErros >= 3) return;
          nErros++;
          window.clarityTag("erro_js", String(rotulo).slice(0, 120));
          if (detalhe) window.clarityTag("erro_js_detalhe", String(detalhe).slice(0, 250));
          window.clarityEvent("erro_js");
          window.clarityUpgrade("erro_js");
        }
        // capture:true porque erro de RECURSO (img/script que não carrega) não borbulha.
        window.addEventListener("error", function (e) {
          var el = e && e.target;
          if (el && el.tagName && (el.src || el.href)) {
            var u = el.src || el.href;
            var host = (u.indexOf("//") > -1 ? u.split("/")[2] : location.host) || "";
            reportaErro("recurso:" + el.tagName.toLowerCase() + ":" + host, u);
            return;
          }
          var arq = e && e.filename ? e.filename : "sem-origem(cross-origin)";
          var origem = arq.indexOf("//") > -1 ? arq.split("/")[2] : arq;
          reportaErro("js:" + origem, (e && e.message ? e.message : "") + " @ " + arq);
        }, true);
        window.addEventListener("unhandledrejection", function (e) {
          var r = e && e.reason;
          reportaErro("promise", (r && (r.message || r)) || "sem motivo");
        });

        // Visitante estável entre sessões: UUID first-party, SEM PII. Permite ver a
        // jornada multi-visita ("leu 4 posts e só então preencheu").
        //
        // O MESMO valor vai para a coluna visitor_id de blog_templum_leads quando o
        // visitante preenche um formulário — é o que liga o lead à gravação da sessão
        // dele no Clarity. Por isso fica exposto em window.__ciUid.
        try {
          var uid = localStorage.getItem("__ci_uid");
          if (!uid) {
            uid = (window.crypto && crypto.randomUUID)
              ? crypto.randomUUID()
              : String(Date.now()) + Math.random().toString(16).slice(2);
            localStorage.setItem("__ci_uid", uid);
          }
          window.__ciUid = uid;
          C("identify", uid);
        } catch (e) {}

        // Clique em CTA de intenção alta. Marca e grava a sessão.
        // /form agora é DO BLOG (navegação interna) — antes era saída para o site, e o
        // lead nascia sem origem. cta_form_site fica como rede de segurança: se algum
        // link para templum.com.br/form voltar (post novo publicado pelo CMS, por
        // exemplo), o clique aparece no Clarity em vez de sumir.
        document.addEventListener("click", function (e) {
          var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;
          if (!a) return;
          var h = a.href || "", ev = "";
          if (/templum\.com\.br\/webinar-/.test(h)) ev = "cta_webinar";
          else if (/v2diagnostico\.templum\.com\.br/.test(h)) ev = "cta_diagnostico";
          else if (/wa\.me|api\.whatsapp\.com/.test(h)) ev = "cta_whatsapp";
          else if (/templum\.com\.br\/form/.test(h)) ev = "cta_form_site";
          else if (a.host === location.host && /^\/form\/?(\?|$)/.test(a.pathname + a.search)) ev = "cta_form_blog";
          if (!ev) return;
          window.clarityEvent(ev);
          window.clarityTag("saiu_para", ev.replace("cta_", ""));
          window.clarityUpgrade(ev);
        }, true);
      })();
    </script>

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="theme-color" content="#222831" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Certificação ISO" href={`${SITE}/rss.xml`} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Certificação ISO" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Schema.org JSON-LD -->
    {allSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <!-- Montserrat self-hosted: preload dos pesos-chave (corpo 500, título 800). Sem CSS externo, sem CLS. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/montserrat-500.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/montserrat-600.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/montserrat-800.woff2" crossorigin />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <!-- Ícones (Iconify) — self-hosted, defer p/ não bloquear o render.
         Os dois arquivos saem de scripts/icones-bundle.mjs e a ORDEM importa: o primeiro
         define window.IconifyPreload com os 40 SVGs que o blog usa, e o componente só o
         lê se ele já existir (defer clássico executa na ordem do documento).
         Antes isto vinha do CDN da jsdelivr E buscava cada SVG em api.iconify.design em
         runtime — dois terceiros no render de 1.020 páginas. Agora é same-origin, com o
         cache imutável de /assets/* (public/_headers). Ícone novo no código → rodar o
         script de novo; sem isso ele volta a ser buscado na API, sem quebrar nada. -->
    <script src="/assets/icons/icones.js" defer is:inline></script>
    <script src="/assets/icons/iconify-icon.min.js" defer is:inline></script>
    <TrackingKit />
  </head>
  <body>
    {!noChrome && <Header />}
    <main>
      <slot />
    </main>
    {!noChrome && <Footer />}
    {!noChrome && (
      <>
        {/* Float só no DESKTOP (WhatsApp). O float da Olívia, que era o par mobile deste,
            saiu em 19/08/2026: no celular a tela é pequena e já tem o dock do webinar
            embaixo e o botão Contato no topo — três elementos fixos pedindo atenção é
            onde o leitor desiste do artigo. */}
        <a class="whatsapp-float float-desktop" href="https://wa.me/5519993521270" target="_blank" rel="noopener" aria-label="Falar no WhatsApp">
          <iconify-icon icon="ic:baseline-whatsapp"></iconify-icon>
        </a>
        {/* Antes do float: o dock esconde a Olívia enquanto está aberto (um pedido por
            vez), e a ordem no DOM deixa isso legível para quem for mexer depois. */}
        {dock && <WebinarDock />}
      </>
    )}
    <script is:inline>
      (function () {
        const els = document.querySelectorAll(".reveal");
        if (!("IntersectionObserver" in window) || !els.length) { els.forEach((el) => el.classList.add("is-in")); return; }
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); } });
        }, { threshold: 0.12 });
        els.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
