---
/**
 * Resumo em áudio do artigo — player próprio, acima do sumário.
 *
 * Não é `<audio controls>`: o controle nativo tem cara diferente em cada navegador
 * (no Chrome desktop é uma barra cinza de 300px que ignora a paleta da marca), e no
 * Safari iOS ele abre em fullscreen. Com controle próprio, o player é o mesmo em
 * todo lugar e cabe na pilha visual de "Resposta rápida" → áudio → "Neste artigo".
 *
 * `preload="none"` é a decisão mais importante deste arquivo. O MP3 tem ~1,4MB —
 * mais que o resto da página inteira. Pré-carregar significaria que TODO leitor de
 * um post com áudio paga 1,4MB de 4G para uma coisa que a maioria não vai tocar, e
 * o INP/LCP do post pagaria por um recurso que ninguém pediu. A duração vem do
 * banco (audio_duration_s), então o rótulo diz "1min32" sem baixar um byte.
 *
 * Props:
 *   url       — URL pública do MP3 (Supabase Storage, já com ?v=<hash>)
 *   duracao   — segundos, do banco. Só para o rótulo e a escala da barra.
 *   titulo    — título do post, para o aria-label
 */
const { url, duracao = 0, titulo = "" } = Astro.props;

const fmt = (s) => {
  const seg = Math.max(0, Math.round(s));
  return `${Math.floor(seg / 60)}:${String(seg % 60).padStart(2, "0")}`;
};
// Rótulo em prosa ("1 min 32 s"), não "1:32": ao lado de "Ouvir o resumo" o
// relógio ainda não tem contexto de que é duração — depois de dar play, tem.
const rotuloDur = duracao
  ? duracao >= 60
    ? `${Math.floor(duracao / 60)} min ${String(duracao % 60).padStart(2, "0")} s`
    : `${duracao} s`
  : "";
---

<div class="post-audio" data-dur={String(duracao)}>
  <audio class="post-audio-el" src={url} preload="none" aria-label={`Resumo em áudio: ${titulo}`}></audio>

  <button type="button" class="post-audio-play" aria-label="Ouvir o resumo em áudio">
    <iconify-icon class="i-play" icon="solar:play-bold"></iconify-icon>
    <iconify-icon class="i-pause" icon="solar:pause-bold"></iconify-icon>
  </button>

  <div class="post-audio-meio">
    <div class="post-audio-topo">
      <span class="post-audio-label">Ouvir o resumo</span>
      {rotuloDur && <span class="post-audio-dur">{rotuloDur}</span>}
      <span class="post-audio-tempo" hidden>0:00</span>
    </div>
    <!-- max em centésimos, não segundos: com passo de 1s a barra de um resumo de 90s
         anda em pulos de 1,1% e o arraste parece travado. -->
    <input class="post-audio-barra" type="range" min="0" max={String(Math.max(1, duracao * 100))}
           value="0" step="1" aria-label="Posição no áudio" disabled />
  </div>

  <button type="button" class="post-audio-vel" aria-label="Velocidade de reprodução">1x</button>
</div>

<script is:inline>
  (function () {
    var box = document.querySelector(".post-audio");
    if (!box) return;

    var el = box.querySelector(".post-audio-el");
    var btn = box.querySelector(".post-audio-play");
    var barra = box.querySelector(".post-audio-barra");
    var tempo = box.querySelector(".post-audio-tempo");
    var dur = box.querySelector(".post-audio-dur");
    var vel = box.querySelector(".post-audio-vel");
    // Duração do banco. Vale como escala da barra até o navegador ler o arquivo e
    // dizer a real — que é a que manda, porque o MP3 é a verdade.
    var total = Number(box.dataset.dur) || 0;

    function mmss(s) {
      s = Math.max(0, Math.round(s || 0));
      return Math.floor(s / 60) + ":" + String(s % 60).padStart(2, "0");
    }

    // ---- Medição -----------------------------------------------------------
    // O que este recurso precisa provar não é clique no play: é que quem ouve
    // converte mais. Play sozinho mede curiosidade; 75% mede atenção de verdade,
    // e é esse o número para cruzar com lead por sessão depois.
    var marcos = { 25: false, 50: false, 75: false, 100: false };
    var jaTocou = false;
    function medir(nome, params) {
      try { if (window.gtag) window.gtag("event", nome, params || {}); } catch (e) {}
    }

    // ---- Play / pause ------------------------------------------------------
    btn.addEventListener("click", function () {
      if (el.paused) {
        el.play().catch(function () {});
      } else {
        el.pause();
      }
    });

    el.addEventListener("play", function () {
      box.classList.add("is-tocando");
      btn.setAttribute("aria-label", "Pausar o resumo em áudio");
      barra.disabled = false;
      tempo.hidden = false;
      if (dur) dur.hidden = true;
      if (!jaTocou) {
        jaTocou = true;
        medir("audio_play", { slug: location.pathname });
        // Uma tag e um evento no Clarity, não um por marco: a conta tem limite de
        // tags e gravações amostradas, e "ouviu áudio: sim" já é o filtro que
        // interessa para assistir a sessão inteira depois.
        try {
          if (window.clarityTag) window.clarityTag("audio", "ouviu");
          if (window.clarityEvent) window.clarityEvent("audio_play");
        } catch (e) {}
      }
    });

    el.addEventListener("pause", function () {
      box.classList.remove("is-tocando");
      btn.setAttribute("aria-label", "Ouvir o resumo em áudio");
    });

    el.addEventListener("loadedmetadata", function () {
      if (isFinite(el.duration) && el.duration > 0) {
        total = el.duration;
        barra.max = String(Math.round(total * 100));
      }
    });

    // ---- Progresso ---------------------------------------------------------
    el.addEventListener("timeupdate", function () {
      if (!arrastando) barra.value = String(Math.round(el.currentTime * 100));
      tempo.textContent = mmss(el.currentTime) + " / " + mmss(total);
      if (!total) return;
      var pct = (el.currentTime / total) * 100;
      [25, 50, 75].forEach(function (m) {
        if (!marcos[m] && pct >= m) {
          marcos[m] = true;
          medir("audio_progresso", { percent: m, slug: location.pathname });
          if (m === 75) {
            try { if (window.clarityTag) window.clarityTag("audio", "ouviu_75"); } catch (e) {}
          }
        }
      });
    });

    el.addEventListener("ended", function () {
      box.classList.remove("is-tocando");
      if (!marcos[100]) {
        marcos[100] = true;
        medir("audio_progresso", { percent: 100, slug: location.pathname });
      }
    });

    // ---- Arrastar -----------------------------------------------------------
    // `arrastando` existe porque timeupdate dispara ~4x/s: sem a trava, cada evento
    // reescreve o value da barra por baixo do dedo do leitor e o arraste "puxa" de volta.
    var arrastando = false;
    barra.addEventListener("pointerdown", function () { arrastando = true; });
    var solta = function () {
      if (!arrastando) return;
      arrastando = false;
      el.currentTime = Number(barra.value) / 100;
    };
    barra.addEventListener("pointerup", solta);
    barra.addEventListener("pointercancel", solta);
    barra.addEventListener("input", function () {
      tempo.textContent = mmss(Number(barra.value) / 100) + " / " + mmss(total);
    });
    // Teclado: setas no range não passam por pointerdown, então o seek precisa
    // acontecer no change — senão a barra move e o áudio não.
    barra.addEventListener("change", function () {
      if (!arrastando) el.currentTime = Number(barra.value) / 100;
    });

    // ---- Velocidade ---------------------------------------------------------
    // 1x → 1,25x → 1,5x. Passa de 1,5 e a voz vira paródia; não vale a opção.
    var vels = [1, 1.25, 1.5];
    var iv = 0;
    vel.addEventListener("click", function () {
      iv = (iv + 1) % vels.length;
      el.playbackRate = vels[iv];
      vel.textContent = String(vels[iv]).replace(".", ",") + "x";
    });

    // Erro de rede não pode virar um play que não faz nada e não explica.
    el.addEventListener("error", function () {
      box.classList.add("is-erro");
      box.querySelector(".post-audio-label").textContent = "Áudio indisponível";
      btn.disabled = true;
    });
  })();
</script>

<style>
  .post-audio {
    display: flex; align-items: center; gap: 14px;
    background: var(--surface); border: 1px solid var(--border-2);
    border-radius: var(--r-16); padding: 12px 16px; margin: 0 0 12px;
    box-shadow: var(--shadow-soft);
  }
  .post-audio.is-erro { opacity: 0.6; }

  .post-audio-play {
    flex: none; width: 44px; height: 44px; border-radius: 50%;
    border: 0; cursor: pointer; background: var(--orange); color: #fff;
    display: grid; place-items: center; font-size: 18px; padding: 0;
    box-shadow: 0 6px 14px -6px rgba(255, 89, 37, 0.7);
    transition: transform 0.16s var(--ease-snap), background 0.16s var(--ease-snap);
  }
  .post-audio-play:hover { transform: scale(1.06); }
  .post-audio-play:active { transform: scale(0.97); }
  .post-audio-play:disabled { background: var(--text-faint); box-shadow: none; cursor: default; transform: none; }
  /* Um ícone por estado, trocado por CSS: sem isto o rótulo do botão precisaria de
     JS para reescrever o innerHTML e o iconify recarregaria o SVG a cada play. */
  .post-audio-play .i-pause,
  .post-audio.is-tocando .post-audio-play .i-play { display: none; }
  .post-audio.is-tocando .post-audio-play .i-pause { display: block; }

  .post-audio-meio { flex: 1 1 auto; min-width: 0; }
  .post-audio-topo { display: flex; align-items: baseline; gap: 8px; }
  .post-audio-label { font-size: 14.5px; font-weight: 800; color: var(--text); }
  .post-audio-dur,
  .post-audio-tempo { font-size: 12.5px; color: var(--text-soft); font-variant-numeric: tabular-nums; }

  /* Barra: 3px em repouso, some quase por completo antes do play — o player fechado
     precisa parecer uma linha de convite, não um controle de mídia esperando input. */
  .post-audio-barra {
    -webkit-appearance: none; appearance: none; width: 100%; height: 3px;
    margin: 8px 0 0; border-radius: 99px; background: var(--border-3);
    cursor: pointer; opacity: 0.5; transition: opacity 0.2s var(--ease-snap);
  }
  .post-audio.is-tocando .post-audio-barra,
  .post-audio-barra:not(:disabled) { opacity: 1; }
  .post-audio-barra:disabled { cursor: default; }
  .post-audio-barra::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none; width: 12px; height: 12px;
    border-radius: 50%; background: var(--orange); border: 2px solid var(--surface);
    box-shadow: 0 1px 4px rgba(24, 25, 27, 0.25);
  }
  .post-audio-barra:disabled::-webkit-slider-thumb { background: var(--border-3); }
  .post-audio-barra::-moz-range-thumb {
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--orange); border: 2px solid var(--surface);
  }
  .post-audio-barra:disabled::-moz-range-thumb { background: var(--border-3); }

  .post-audio-vel {
    flex: none; border: 1px solid var(--border-2); background: transparent;
    color: var(--text-2); border-radius: 99px; padding: 5px 10px;
    font-family: var(--font-sans); font-size: 12px; font-weight: 800;
    cursor: pointer; font-variant-numeric: tabular-nums;
  }
  .post-audio-vel:hover { border-color: var(--orange); color: var(--orange-ink); }

  @media (max-width: 520px) {
    .post-audio { gap: 11px; padding: 11px 13px; }
    .post-audio-play { width: 40px; height: 40px; font-size: 16px; }
    .post-audio-label { font-size: 13.5px; }
    /* O seletor de velocidade é o primeiro a sair no celular: ocupa a mesma largura
       de um dedo e é o controle que menos gente usa num resumo de 90 segundos. */
    .post-audio-vel { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-audio-play, .post-audio-barra { transition: none; }
    .post-audio-play:hover, .post-audio-play:active { transform: none; }
  }
</style>
