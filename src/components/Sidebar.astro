---
// Sidebar do artigo (rola com o texto, ver o comentário do .sb no <style>):
// autor + webinar da semana + CTA de consultoria (→ /form) + relacionados.
//
// Por que relacionados e não recentes: quem lê um artigo está numa dúvida
// específica. "Recentes" entrega o que saiu por último — pode ser PBQP-H para
// quem pesquisa ISO 27001 — o que aumenta o abandono. Relacionado mantém o
// leitor no mesmo tema, sobe páginas por sessão e ele chega mais aquecido no CTA.
//
// A lista vem do [slug].astro já sem os 3 posts do bloco do rodapé, para a
// mesma página não repetir link (link repetido não soma link interno).
// Sem data de propósito: em card de relacionados a relevância importa mais que a
// recência, e data antiga em post ainda válido derruba o clique.
import { ctaParaNorma, ROTULO_DO_CTA } from "../data/cta-norma.js";
import { chamadaDaNorma } from "../data/normas.js";
import WebinarCard from "./WebinarCard.astro";

const {
  ref = "", author = "Equipe Templum", related = [], catName = "", catSlug = "",
  categories = [], norma = "", ctaUrl = "",
} = Astro.props;

// utm_term leva a norma para dar pra medir conversão por norma, não só do blog todo.
// A copy do card sai do RÓTULO da norma (normaDaPagina), não do slug de cta-norma.js:
// "Precisa da ISO 9001?" precisa dizer a norma que o leitor pesquisou, e o slug agrupa
// (LGPD e 27701 caem em "iso-27001"). O slug segue valendo para o utm_term e o
// data-trk-norma, que é onde agrupar ajuda.
const cta = ctaParaNorma(categories);
// `norma` (título/slug/tags) primeiro, porque é o rótulo exato do que o leitor pesquisou;
// o do CTA entra quando ele falta, e é o que leva a chamada de 37% para 92% dos posts.
const rotulo = norma || ROTULO_DO_CTA[cta.slug] || "";
const chamada = chamadaDaNorma(rotulo);
// Destino: /form (a página de conversão DO BLOG), não mais o v2diagnostico.templum.com.br.
// Motivo em pages/form.astro: cruzar de domínio parte a sessão do Clarity no meio
// (localStorage é por origem) e o lead nascia como lead do SITE, sem a página de origem.
// A URL vem pronta de [slug].astro porque nas 14 páginas curadas o form já está na
// própria página e o CTA ancora nele (#consultoria) em vez de mandar o leitor embora.
const href = ctaUrl || `/form/?utm_source=blog&utm_medium=sidebar&utm_campaign=${ref}&utm_term=${cta.slug}`;
---
<aside class="sb">
  <!-- Autor -->
  <div class="sb-author">
    <span class="sb-author-av"><iconify-icon icon="solar:user-bold"></iconify-icon></span>
    <div><span class="sb-author-by">Escrito por</span><strong>{author}</strong></div>
  </div>

  <!-- Webinar da semana ACIMA do card da Olívia: é oferta com data, perde valor a cada
       dia; o diagnóstico não expira. Só aparece no desktop (ver WebinarCard.astro) —
       no mobile a sidebar desce pro fim da página e quem serve é o card do conteúdo. -->
  <WebinarCard variante="sidebar" />

  <!-- CTA único: falar com especialista (o diagnóstico entra como o que ele entrega) -->
  <div class="sb-diagnostico">
    <img class="sb-diagnostico-photo" src="/assets/team/olivia-especialista.webp" alt="Olívia, especialista Templum" width="72" height="72" decoding="async" />
    <h3>{chamada}</h3>
    <p>
      Fale com um especialista da Templum{rotulo && rotulo !== "ESG" ? ` sobre ${rotulo}` : ""}:
      você recebe um diagnóstico gratuito do seu cenário, com prazo e investimento claros.
    </p>
    <!-- O evento continua "cta-sidebar-diagnostico" mesmo com destino e copy novos, pelo
         mesmo motivo do "cta-artigo" em [slug].astro: renomear zera a série no GA4/Meta
         justo quando ela serve de linha de base para comparar o /form com o diagnóstico. -->
    <a
      href={href}
      class="btn btn--primary btn--block"
      data-trk-event="cta-sidebar-diagnostico"
      data-trk-norma={cta.slug}
    >Falar com um especialista <iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
    <span class="sb-diagnostico-selo">Gratuito · sem compromisso</span>
  </div>

  <!-- Artigos relacionados (abaixo da Olívia: o topo do sidebar é o espaço de
       conversão; relacionado é a saída para quem ainda não está pronto) -->
  {related.length > 0 && (
    <div class="sb-recent">
      <h4>Artigos relacionados</h4>
      <ul>{related.map((p) => (
        <li>
          <a href={`/${p.slug}/`} data-trk-event="link-sidebar-relacionado">
            <iconify-icon icon="solar:arrow-right-linear"></iconify-icon>
            <span class="sb-recent-t">{p.data.title}</span>
          </a>
        </li>
      ))}</ul>
      {catSlug && (
        <a class="sb-recent-all" href={`/categoria/${catSlug}/`}>Ver todos sobre {catName}</a>
      )}
    </div>
  )}
</aside>
<style>
  /* SEM sticky, de propósito. A coluna rola junto com o texto, sempre.
     Histórico, pra ninguém reintroduzir: já foi sticky na aside inteira (se mais alta
     que a viewport, crava o topo e o card de relacionados só aparecia quando o texto
     acabava) e sticky só no bloco de cima (os irmãos de baixo rolavam POR BAIXO dele,
     porque elemento posicionado pinta acima de estático). A terceira tentativa foi
     sticky progressivo — só ligava em janela ≥981px de largura e ≥880px de altura —
     e o defeito dela é o motivo desta versão: o mesmo post fixava a coluna na tela
     de um leitor e rolava na de outro, dependendo do tamanho da janela. Rolar sempre
     é pior slot de conversão e comportamento único, que é o que se pede num artigo. */
  .sb { align-self: start; display: flex; flex-direction: column; gap: 18px; }

  .sb-author { display: flex; align-items: center; gap: 12px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-16); padding: 14px 18px; }
  .sb-author-av { width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; background: rgba(255,89,37,0.12); color: var(--orange); font-size: 22px; flex-shrink: 0; }
  .sb-author-by { display: block; font-size: 12px; color: var(--text-soft); }
  .sb-author strong { font-size: 15px; font-weight: 800; color: var(--text); }

  /* Card inteiro clicável (link esticado) — ver o comentário em [slug].astro: a foto e o
     título não eram link e comiam clique. */
  .sb-diagnostico { position: relative; background: var(--navy); color: var(--cream); border-radius: var(--r-20); padding: 28px 24px; text-align: center; }
  .sb-diagnostico .btn::after { content: ""; position: absolute; inset: 0; }
  .sb-diagnostico-photo { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; display: block; margin: 0 auto 16px; border: 3px solid var(--orange); }
  .sb-diagnostico h3 { color: var(--cream); font-size: 20px; font-weight: 800; line-height: 1.2; margin-bottom: 8px; }
  .sb-diagnostico p { font-size: 14px; line-height: 1.55; color: rgba(255,244,221,0.78); margin-bottom: 18px; }
  .sb-diagnostico-selo { display: block; margin-top: 10px; font-size: 11.5px; color: rgba(255,244,221,0.55); }

  .sb-recent { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-20); padding: 22px 24px; }
  .sb-recent h4 { font-size: 14px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 14px; }
  .sb-recent ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .sb-recent li + li { border-top: 1px solid var(--border); padding-top: 14px; }
  .sb-recent ul a { display: flex; gap: 8px; align-items: baseline; }
  .sb-recent ul a iconify-icon { color: var(--orange); font-size: 14px; flex-shrink: 0; transition: transform .2s; }
  .sb-recent ul a:hover iconify-icon { transform: translateX(3px); }
  .sb-recent-t { display: block; font-size: 14px; font-weight: 700; color: var(--text-2); line-height: 1.35; }
  .sb-recent a:hover .sb-recent-t { color: var(--orange); }
  .sb-recent-all { display: inline-block; margin-top: 16px; font-size: 13px; font-weight: 700; color: var(--orange); }
  .sb-recent-all:hover { text-decoration: underline; }
</style>
