---
// Sidebar do artigo (sticky no desktop): autor + CTA diagnóstico + relacionados.
//
// Por que relacionados e não recentes: quem lê um artigo está numa dúvida
// específica. "Recentes" entrega o que saiu por último — pode ser PBQP-H para
// quem pesquisa ISO 27001 — o que aumenta o abandono. Relacionado mantém o
// leitor no mesmo tema, sobe páginas por sessão e ele chega mais aquecido no CTA.
//
// A lista vem do [slug].astro já sem os 3 posts do bloco do rodapé, para a
// mesma página não repetir link (link repetido não soma link interno).
// Sem data de propósito: em card de relacionados a relevância importa mais que a
// recência, e data antiga em post ainda válido derruba o clique.
import { ctaParaNorma } from "../data/cta-norma.js";

const { ref = "", author = "Equipe Templum", related = [], catName = "", catSlug = "", categories = [] } = Astro.props;

// CTA da Olívia contextualizado pela norma do artigo (ver data/cta-norma.js).
// utm_term leva a norma para dar pra medir conversão por norma, não só do blog todo.
const cta = ctaParaNorma(categories);
const diagnosticoUrl = `https://v2diagnostico.templum.com.br/blog?utm_source=blog&utm_medium=sidebar&utm_campaign=${ref}&utm_term=${cta.slug}`;
---
<aside class="sb">
  <!-- Só o bloco que CABE na viewport é sticky (autor + CTA ≈ 450px). A aside
       inteira era sticky e, por passar da altura da tela, o navegador gravava o
       topo e o fim do card nunca subia: os relacionados só apareciam quando o
       texto do artigo terminava. Com o sticky no bloco curto, o CTA acompanha o
       artigo inteiro e nada fica preso esperando o fim do texto. -->
  <div class="sb-fixo">
  <!-- Autor -->
  <div class="sb-author">
    <span class="sb-author-av"><iconify-icon icon="solar:user-bold"></iconify-icon></span>
    <div><span class="sb-author-by">Escrito por</span><strong>{author}</strong></div>
  </div>

  <!-- CTA único: diagnóstico com a Olívia -->
  <div class="sb-diagnostico">
    <img class="sb-diagnostico-photo" src="/assets/team/olivia-especialista.png" alt="Olívia, especialista Templum" />
    <h3>{cta.titulo}</h3>
    <p>{cta.texto}</p>
    <a
      href={diagnosticoUrl}
      class="btn btn--primary btn--block"
      data-trk-event="cta-sidebar-diagnostico"
      data-trk-norma={cta.slug}
    >Quero meu diagnóstico <iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
    <span class="sb-diagnostico-selo">Gratuito · sem compromisso</span>
  </div>
  </div><!-- /.sb-fixo -->

  <!-- Artigos relacionados (abaixo da Olívia: o topo do sidebar é o espaço de
       conversão; relacionado é a saída para quem ainda não está pronto) -->
  {related.length > 0 && (
    <div class="sb-recent">
      <h4>Artigos relacionados</h4>
      <ul>{related.map((p) => (
        <li>
          <a href={`/${p.slug}/`} data-trk-event="link-sidebar-relacionado">
            <iconify-icon icon="solar:arrow-right-linear"></iconify-icon>
            <span class="sb-recent-t">{p.data.title}</span>
          </a>
        </li>
      ))}</ul>
      {catSlug && (
        <a class="sb-recent-all" href={`/categoria/${catSlug}/`}>Ver todos sobre {catName}</a>
      )}
    </div>
  )}
</aside>
<style>
  /* A aside estica na altura da linha do grid para dar pista de rolagem ao bloco
     sticky de dentro. Ela mesma NÃO é sticky (era o que travava o card). */
  .sb { align-self: stretch; display: flex; flex-direction: column; gap: 18px; }
  .sb-fixo { position: sticky; top: 96px; display: flex; flex-direction: column; gap: 18px; }
  /* Janela muito baixa (notebook pequeno, navegador com muitas barras): nem o bloco
     curto cabe — aí sticky volta a prender, então desliga e deixa rolar normal. */
  @media (max-height: 620px) { .sb-fixo { position: static; } }
  @media (max-width: 980px) { .sb-fixo { position: static; } }

  .sb-author { display: flex; align-items: center; gap: 12px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-16); padding: 14px 18px; }
  .sb-author-av { width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; background: rgba(255,89,37,0.12); color: var(--orange); font-size: 22px; flex-shrink: 0; }
  .sb-author-by { display: block; font-size: 12px; color: var(--text-soft); }
  .sb-author strong { font-size: 15px; font-weight: 800; color: var(--text); }

  .sb-diagnostico { background: var(--navy); color: var(--cream); border-radius: var(--r-20); padding: 28px 24px; text-align: center; }
  .sb-diagnostico-photo { width: 88px; height: 88px; border-radius: 50%; object-fit: cover; display: block; margin: 0 auto 16px; border: 3px solid var(--orange); }
  .sb-diagnostico h3 { color: var(--cream); font-size: 20px; font-weight: 800; line-height: 1.2; margin-bottom: 8px; }
  .sb-diagnostico p { font-size: 14px; line-height: 1.55; color: rgba(255,244,221,0.78); margin-bottom: 18px; }
  .sb-diagnostico-selo { display: block; margin-top: 10px; font-size: 11.5px; color: rgba(255,244,221,0.55); }

  .sb-recent { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-20); padding: 22px 24px; }
  .sb-recent h4 { font-size: 14px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 14px; }
  .sb-recent ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .sb-recent li + li { border-top: 1px solid var(--border); padding-top: 14px; }
  .sb-recent ul a { display: flex; gap: 8px; align-items: baseline; }
  .sb-recent ul a iconify-icon { color: var(--orange); font-size: 14px; flex-shrink: 0; transition: transform .2s; }
  .sb-recent ul a:hover iconify-icon { transform: translateX(3px); }
  .sb-recent-t { display: block; font-size: 14px; font-weight: 700; color: var(--text-2); line-height: 1.35; }
  .sb-recent a:hover .sb-recent-t { color: var(--orange); }
  .sb-recent-all { display: inline-block; margin-top: 16px; font-size: 13px; font-weight: 700; color: var(--orange); }
  .sb-recent-all:hover { text-decoration: underline; }
</style>
