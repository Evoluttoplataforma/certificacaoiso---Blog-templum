---
// badge: selo opcional no card (a home marca os posts em alta no Search Console).
// Opcional de propósito: quem lista por categoria ou relacionado não tem esse contexto.
const { post, badge } = Astro.props;
const d = post.data;
const url = `/${post.slug}/`;
// Data do card: a de REVISÃO quando existe, a de publicação quando não. Mesma regra do
// post (ver o comentário da hierarquia da data em pages/[slug].astro), e por um motivo
// concreto: em 21/08/2026 o post passou a esconder a data de publicação onde há revisão
// curada, e o card continuava mostrando "28 de nov. de 2016" no bloco de relacionados da
// própria página — o leitor via a data velha que a página acabou de tirar de vista.
// A guarda `> pubDate` é a mesma do post: revised_at anterior à publicação é resíduo de
// migração e não deve virar "atualizado".
const dataDoCard = d.revisedDate && +new Date(d.revisedDate) > +new Date(d.pubDate)
  ? new Date(d.revisedDate) : new Date(d.pubDate);
const dataFmt = dataDoCard.toLocaleDateString("pt-BR", { day: "2-digit", month: "short", year: "numeric" });
const cat = (d.categories && d.categories[0]) || "";

// Imagem do card em 3 larguras (ver scripts/imagens-webp.mjs). A URL vem do BANCO
// (blog_templum_categories.image_url), então não dá para usar <Image> do astro:assets,
// que precisa de import estático — o srcset é montado por string, e só quando a URL tem
// a forma exata que o script gera. Qualquer outra (jpg, externa, categoria nova ainda sem
// variante) cai no <img> simples de antes, sem srcset: melhor perder a otimização do que
// apontar para um arquivo que não existe.
// `sizes` calculado da grade real (.blog-grid + .container.lg, 1200px, gap 26px):
// 1 coluna até 600px, 2 até 900px, 3 acima — daí 366px no desktop.
const mCat = /^\/assets\/categorias\/([a-z0-9-]+)\.webp$/.exec(d.categoryImage || "");
const thumbSrcset = mCat
  ? `/assets/categorias/${mCat[1]}-400.webp 400w, /assets/categorias/${mCat[1]}-640.webp 640w, ${d.categoryImage} 800w`
  : undefined;
const thumbSizes = thumbSrcset
  ? "(max-width: 600px) calc(100vw - 36px), (max-width: 900px) calc(50vw - 37px), 366px"
  : undefined;
---
<article class="ac">
  <a href={url} class="ac-thumb" aria-label={d.title}>
    {d.categoryImage ? <img src={d.categoryImage} srcset={thumbSrcset} sizes={thumbSizes} alt="" width="800" height="533" loading="lazy" decoding="async" onerror="this.style.display='none'" /> : <span class="ac-thumb-fb"><iconify-icon icon="solar:document-text-bold"></iconify-icon></span>}
  </a>
  <div class="ac-body">
    <span class="ac-tags">
      {cat && <span class="ac-cat">{cat}</span>}
      {badge && <span class="ac-badge"><iconify-icon icon="solar:graph-up-bold"></iconify-icon> {badge}</span>}
    </span>
    <h2 class="ac-title"><a href={url}>{d.title}</a></h2>
    <p class="ac-desc">{d.description}</p>
    <div class="ac-meta"><span>{d.author}</span><span>·</span><time datetime={dataDoCard.toISOString()}>{dataFmt}</time></div>
  </div>
</article>
