---
// Formulário de consultoria no fim do artigo — captura lead qualificado por norma.
//
// Onde fica e por quê: DEPOIS do conteúdo e do FAQ, substituindo o CTA genérico
// (.post-cta) nas páginas da lista em data/lead-form-pages.js. O funil da página fica
// com dois degraus que não competem: no alto da sidebar o diagnóstico da Olívia (zero
// campo, atrito mínimo) e no fim do artigo este form (7 campos, lead qualificado) —
// para quem leu tudo, inclusive as objeções respondidas no FAQ, e ainda quer falar.
//
// ---------------------------------------------------------------------------
// PARA ONDE O LEAD VAI (dois destinos, de propósito)
//
// 1. blog_templum_leads (Supabase, POST anon no REST — mesmo caminho das iscas de
//    /presentes/*, coberto pela policy leads_anon_insert). É o registro do BLOG:
//    permite analisar conversão por página, que é o que o CRM não responde.
//
// 2. https://templum.com.br/api/lead — o MESMO endpoint que o formulário do /form
//    do site usa. Ele encadeia site_leads + Mailchimp + Meta CAPI + ManyChat +
//    Pipedrive + Orbit numa transação só. Reusar isso em vez de falar direto com o
//    CRM evita três armadilhas que já custaram caro nesta integração:
//
//      a) FUNIL. A edge function create-orbit-crm-lead joga no pipeline
//         7b522de3…; o site joga no 346d6495…. São funis diferentes — lead do blog
//         indo pro primeiro não aparece na fila que o time comercial abre.
//      b) VOCABULÁRIO. cf_produto, cf_faixa_de_funcion_rios e cf_faixa_de_faturamento
//         são SELECT no Orbit. Valor fora da lista faz o saveToOrbit reenviar sem
//         NENHUM custom field (é o fallback dele) — o lead entra, mas cego: sem
//         porte, sem faturamento, sem página, sem UTM. Por isso as options abaixo
//         são cópia literal das de site/src/components/LeadForm.astro, e o
//         faturamento é MENSAL (o do site é), não anual.
//      c) DUPLICIDADE. /api/lead já chama o Orbit. Chamar a edge function também
//         criaria dois leads para a mesma pessoa, em dois funis.
//
// O POST cross-origin usa content-type text/plain + mode no-cors: assim ele é uma
// "simple request" e não dispara preflight OPTIONS — que o worker do site responderia
// com 405, porque a rota só aceita POST. O corpo continua JSON e o handler faz
// request.json() normalmente. Em troca a resposta é opaca: quem confirma que o lead
// existe é o registro em blog_templum_leads, não este fetch.
// ---------------------------------------------------------------------------
//
// Campos obrigatórios: nome, e-mail, WhatsApp, empresa, funcionários e urgência.
// Faturamento fica OPCIONAL de propósito: é o campo mais sensível do formulário e o
// que mais faz desistir no meio. Porte + urgência já qualificam o suficiente para o
// time priorizar a fila; faturamento é bônus quando o lead está confortável.
//
// A lista de urgência é a do site — e ela vale mais aqui do que lá, porque blog atrai
// estudante e curioso em volume. "Sou apenas estudante" e "Preciso para minha
// carreira" tiram esses leads da fila comercial sem precisar de um campo a mais.
const { norma, crmNorma = "", slug = "", sbUrl, sbAnon } = Astro.props;

const funcionarios = ["1 a 10", "11 a 50", "51 a 100", "101 a 250", "251 a 500", "Mais de 500"];
const faturamentos = ["Até R$ 50 mil", "R$ 50 mil a R$ 100 mil", "R$ 100 mil a R$ 300 mil", "R$ 300 mil a R$ 500 mil", "R$ 500 mil a R$ 1 milhão", "Acima de R$ 1 milhão"];
const urgencias = ["Preciso certificar rápido", "Estou sem pressa para certificar", "Preciso para minha carreira", "Sou apenas estudante"];
---

<section class="lead-form lead-card" id="consultoria">
  <div class="lf-head">
    <span class="lf-tag"><iconify-icon icon="solar:medal-ribbon-star-bold"></iconify-icon> Consultoria Templum</span>
    <h2>Precisa de consultoria para {norma}?</h2>
    <p>Fale com nosso especialista. Conte o cenário da sua empresa e a gente responde com o caminho até a certificação — sem custo e sem compromisso.</p>
  </div>

  <form class="form lf-form" id="leadForm" novalidate>
    <div class="form-row">
      <div class="field">
        <label for="lf-nome">Nome</label>
        <input class="input" id="lf-nome" name="nome" autocomplete="name" placeholder="Seu nome" required />
      </div>
      <div class="field">
        <label for="lf-email">E-mail</label>
        <input class="input" id="lf-email" name="email" type="email" autocomplete="email" placeholder="voce@empresa.com" required />
      </div>
    </div>

    <div class="form-row">
      <div class="field">
        <label for="lf-tel">WhatsApp</label>
        <input class="input" id="lf-tel" name="telefone" type="tel" inputmode="numeric" autocomplete="tel" placeholder="(00) 00000-0000" required />
      </div>
      <div class="field">
        <label for="lf-empresa">Empresa</label>
        <input class="input" id="lf-empresa" name="empresa" autocomplete="organization" placeholder="Nome da empresa" required />
      </div>
    </div>

    <div class="form-row">
      <div class="field">
        <label for="lf-func">Nº de funcionários</label>
        <select class="select" id="lf-func" name="funcionarios" required>
          <option value="" selected disabled>Selecione</option>
          {funcionarios.map((f) => <option value={f}>{f}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="lf-urg">Qual sua urgência?</label>
        <select class="select" id="lf-urg" name="urgencia" required>
          <option value="" selected disabled>Selecione</option>
          {urgencias.map((u) => <option value={u}>{u}</option>)}
        </select>
      </div>
    </div>

    <div class="field">
      <label for="lf-fat">Faturamento mensal <span class="hint">— opcional, ajuda a dimensionar a proposta</span></label>
      <select class="select" id="lf-fat" name="faturamento">
        <option value="" selected>Prefiro não informar</option>
        {faturamentos.map((f) => <option value={f}>{f}</option>)}
      </select>
    </div>

    {/* isca de bot: campo fora do fluxo visual e do tab. Preenchido = descarta em silêncio. */}
    <div class="lf-hp" aria-hidden="true">
      <label for="lf-site">Site</label>
      <input id="lf-site" name="site" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <button type="submit" class="btn btn--primary btn--block btn--lg" data-trk-event="lead-form-artigo" data-trk-norma={norma}>
      Falar com um especialista <iconify-icon icon="solar:arrow-right-linear"></iconify-icon>
    </button>
    <p class="lf-legal">Ao enviar, você concorda em receber contato da Templum sobre a certificação {norma}. Seus dados são protegidos conforme a LGPD e não são compartilhados com terceiros.</p>
  </form>

  <div class="form-success lf-success" id="leadSuccess" hidden>
    <iconify-icon icon="solar:check-circle-bold"></iconify-icon>
    <div>
      <h3>Recebemos seus dados!</h3>
      <p>Um especialista em {norma} vai entrar em contato pelo WhatsApp que você informou. Se preferir adiantar, responda a esta mesma mensagem quando ele chamar com a sua dúvida principal — a conversa rende mais.</p>
    </div>
  </div>
</section>

<style>
  .lead-form { margin: 44px 0 8px; scroll-margin-top: 96px; }
  .lf-head { margin-bottom: 22px; }
  .lf-tag { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.05em; color: var(--orange-ink);
    background: rgba(255,89,37,0.10); border-radius: 999px; padding: 6px 12px; margin-bottom: 14px; }
  .lf-head h2 { font-size: clamp(22px, 2.6vw, 30px); font-weight: 800; letter-spacing: -0.025em; margin: 0 0 10px; }
  .lf-head p { font-size: 15.5px; line-height: 1.6; color: var(--text-mid); margin: 0; max-width: 620px; }
  .lf-form { display: flex; flex-direction: column; gap: 16px; }
  /* select nativo: a seta padrão do sistema quebra o alinhamento com .input em Safari */
  .lf-form .select { appearance: none; -webkit-appearance: none; background-image:
      linear-gradient(45deg, transparent 50%, var(--text-soft) 50%),
      linear-gradient(135deg, var(--text-soft) 50%, transparent 50%);
    background-position: right 18px center, right 13px center; background-size: 5px 5px, 5px 5px;
    background-repeat: no-repeat; padding-right: 38px; }
  .lf-legal { font-size: 11.5px; color: var(--text-soft); line-height: 1.5; margin: 2px 0 0; }
  /* honeypot: invisível sem display:none (bot lê estilo e ignora campo escondido assim) */
  .lf-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .lf-success { display: flex; gap: 14px; align-items: flex-start; }
  .lf-success h3 { font-size: 19px; font-weight: 800; margin: 0 0 6px; }
  .lf-success p { font-size: 15px; line-height: 1.6; color: var(--text-mid); margin: 0; }
  .lf-success :global(iconify-icon) { font-size: 30px; color: var(--success, #16a34a); flex-shrink: 0; }
  .form[hidden], .form-success[hidden] { display: none; }
  @media (max-width: 620px) { .lead-form .form-row { grid-template-columns: 1fr; } }
</style>

<script is:inline define:vars={{ SB_URL: sbUrl, SB_ANON: sbAnon, slug, norma, crmNorma }}>
  (function () {
    var form = document.getElementById("leadForm");
    if (!form) return;
    var success = document.getElementById("leadSuccess");

    // --- Clarity: os três degraus do formulário ---------------------------
    // O Clarity enxerga scroll e clique, mas não sabe o que é "o form apareceu",
    // "o cara começou a preencher" e "enviou". Sem esses três nomes na timeline não
    // há como isolar a sessão de quem tentou e desistiu — que é justamente a que
    // explica lead perdido. O upgrade() no start garante que ela seja gravada.
    function cStage(etapa, motivo) {
      if (window.clarityTag) window.clarityTag("funil", etapa);
      if (window.clarityEvent) window.clarityEvent("form_" + etapa);
      if (motivo && window.clarityUpgrade) window.clarityUpgrade("form_" + etapa);
    }

    if (window.IntersectionObserver) {
      var io = new IntersectionObserver(function (entries) {
        if (entries.some(function (en) { return en.isIntersecting; })) {
          io.disconnect();
          cStage("visto");
        }
      }, { threshold: 0.4 });
      io.observe(form);
    }

    form.addEventListener("focusin", function onFirst() {
      form.removeEventListener("focusin", onFirst);
      cStage("start", true);
    });

    // Máscara de telefone — o site tem esse handler no Base.astro; aqui é local.
    var tel = document.getElementById("lf-tel");
    if (tel) {
      tel.addEventListener("input", function () {
        var d = tel.value.replace(/\D/g, "").substring(0, 11);
        if (!d.length) { tel.value = ""; return; }
        if (d.length <= 2) tel.value = "(" + d;
        else if (d.length <= 6) tel.value = "(" + d.slice(0, 2) + ") " + d.slice(2);
        else if (d.length <= 10) tel.value = "(" + d.slice(0, 2) + ") " + d.slice(2, 6) + "-" + d.slice(6);
        else tel.value = "(" + d.slice(0, 2) + ") " + d.slice(2, 7) + "-" + d.slice(7);
      });
    }

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }

      // Trava de disparo único: duplo clique não pode gerar dois leads no CRM.
      if (form.dataset.leadSubmitted === "1") return;
      form.dataset.leadSubmitted = "1";
      var btn = form.querySelector('[type="submit"]');
      if (btn) btn.disabled = true;

      var d = {};
      new FormData(form).forEach(function (v, k) { d[k] = typeof v === "string" ? v.trim() : v; });

      // bot preencheu o honeypot: mostra sucesso e não grava nada.
      if (d.site) {
        if (window.clarityTag) window.clarityTag("bot", "sim");
        form.hidden = true; if (success) success.hidden = false; return;
      }

      var pagina = "/" + slug + "/";

      // Clarity: converteu. `lead=sim` vira segmento — dá pra comparar a gravação de
      // quem fechou com a de quem parou no mesmo campo, na mesma página.
      if (window.clarityTag) {
        window.clarityTag("lead", "sim");
        window.clarityTag("lead_norma", norma || "");
        window.clarityTag("lead_urgencia", d.urgencia || "");
      }
      cStage("lead", true);

      if (window.trk && typeof window.trk.lead === "function") {
        try { window.trk.lead({ email: d.email, phone: d.telefone, name: d.nome }); } catch (_) {}
      }

      // 1) registro do blog — fonte de verdade para conversão POR PÁGINA
      try {
        fetch(SB_URL + "/rest/v1/blog_templum_leads", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            apikey: SB_ANON,
            Authorization: "Bearer " + SB_ANON,
            Prefer: "return=minimal",
          },
          keepalive: true,
          body: JSON.stringify({
            name: d.nome || "",
            email: d.email || "",
            phone: d.telefone || "",
            company: d.empresa || "",
            headcount: d.funcionarios || "",
            revenue: d.faturamento || "",
            urgency: d.urgencia || "",
            norma: norma || "",
            source: "consultoria-artigo",
            page: pagina,
            // Liga este lead à gravação da sessão no Clarity (ver Base.astro).
            // localStorage bloqueado (aba privada) → vazio, e o lead entra igual.
            visitor_id: window.__ciUid || "",
          }),
        });
      } catch (_) {}

      // 2) pipeline oficial de lead da Templum (site_leads + Mailchimp + CAPI +
      //    ManyChat + Pipedrive + Orbit). Mesmo endpoint do /form do site.
      try {
        var p = new URLSearchParams(location.search);
        var utm = {};
        ["utm_source","utm_medium","utm_campaign","utm_term","utm_content",
         "gclid","fbclid","gad_source","gad_campaignid","msclkid","ttclid","gbraid","wbraid"
        ].forEach(function (k) { if (p.get(k)) utm[k] = p.get(k); });
        if (!utm.utm_source) utm.utm_source = "blog";
        if (!utm.utm_medium) utm.utm_medium = "organico";
        if (!utm.utm_campaign) utm.utm_campaign = "form-consultoria-artigo";
        if (!utm.utm_term) utm.utm_term = slug;

        // `norma` vai com o valor do CRM (cf_produto é select). Quando a página não
        // tem produto equivalente lá, vai vazio e o interesse real fica na mensagem.
        var msg = "Lead do blog: formulário de consultoria no fim do artigo " + pagina +
                  "\nInteresse declarado: " + norma +
                  "\nUrgência: " + (d.urgencia || "não informado");

        fetch("https://templum.com.br/api/lead", {
          method: "POST",
          mode: "no-cors", // simple request: sem preflight (a rota do site só aceita POST)
          headers: { "Content-Type": "text/plain;charset=UTF-8" },
          keepalive: true,
          body: JSON.stringify(Object.assign({
            nome: d.nome || "",
            email: d.email || "",
            telefone: d.telefone || "",
            empresa: d.empresa || "",
            norma: crmNorma || "",
            funcionarios: d.funcionarios || "",
            faturamento: d.faturamento || "",
            urgencia: d.urgencia || "",
            mensagem: msg,
            evento: "blog-consultoria",
            pagina: "https://certificacaoiso.com.br" + pagina,
          }, utm)),
        });
      } catch (_) {}

      form.hidden = true;
      if (success) success.hidden = false;
      if (success && success.scrollIntoView) success.scrollIntoView({ behavior: "smooth", block: "center" });
    });
  })();
</script>
